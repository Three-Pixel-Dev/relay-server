SERVER_PORT=8080
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
SPRING_DATASOURCE_URL="jdbc:postgresql://HOST/neondb?sslmode=require&channel_binding=require"
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
APP_SECURITY_MODE=jwt

# Comma-separated browser origins for credentialed CORS
CORS_ALLOWED_ORIGINS=https://dev-relay.saungera.com,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Comma-separated Google OAuth client IDs (Web / Android / iOS audiences)
GOOGLE_OAUTH_CLIENT_IDS=

# Stripe card Checkout (Embedded). Same keys pattern as Payni STRIPE_* .
# When STRIPE_SECRET_KEY is empty, /subscribe activates locally (dev only).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/connections?stripe=success
STRIPE_CANCEL_URL=http://localhost:5173/connections?stripe=cancel

# Local disk root for uploaded source files
RELAY_STORAGE_ROOT=./storage

# Dev pgvector auto-bootstrap (set to false in Neon prod after running src/main/resources/db/migration/V1__phase1_pgvector_and_sources.sql)
RELAY_PGVECTOR_AUTO_MIGRATE=true

# Fallback Google Gemini API key (AIza...) for gemini-embedding-2 (1536d) and gemini-3.8-flash when user has not connected a key in UI
GEMINI_API_KEY=

# YouTube Data API v3 key for reading YouTube channels and videos
YOUTUBE_API_KEY=

# Playwright Chromium for WEB sources (keep max-concurrent=1 on GCP e2-medium)
# Option A (Docker Playwright server — no local Chromium/apt deps needed):
#   docker run --rm -d --name relay-playwright -p 3000:3000 mcr.microsoft.com/playwright:v1.49.0-jammy /bin/bash -c "npx -y playwright@1.49.0 run-server --port 3000 --host 0.0.0.0"
#   Then set RELAY_WEB_PLAYWRIGHT_WS_ENDPOINT=ws://127.0.0.1:3000/
#   (App skips local browser download when ws-endpoint is set — do not omit that var.)
# Option B (Local Chromium on host — leave RELAY_WEB_PLAYWRIGHT_WS_ENDPOINT empty):
#   mvn -q exec:java -Dexec.mainClass=com.microsoft.playwright.CLI -Dexec.args="install --with-deps chromium"
RELAY_WEB_PLAYWRIGHT_WS_ENDPOINT=
RELAY_WEB_PLAYWRIGHT_HEADLESS=true
RELAY_WEB_PLAYWRIGHT_TIMEOUT_MS=30000
RELAY_WEB_PLAYWRIGHT_MAX_CONCURRENT=1
RELAY_WEB_PLAYWRIGHT_SETTLE_MS=1500

# Spring Mail SMTP fallback for Partners (placeholders only — set real values in .env)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
RELAY_MAIL_FROM=

# AES-256-GCM for Gmail OAuth tokens (Base64 of exactly 32 random bytes). No Cloud KMS.
# Generate: openssl rand -base64 32
RELAY_TOKEN_ENCRYPTION_KEY=
RELAY_TOKEN_ENCRYPTION_KEY_VERSION=1
RELAY_TOKEN_ENCRYPTION_PREVIOUS_KEY=
RELAY_TOKEN_ENCRYPTION_PREVIOUS_KEY_VERSION=0

# Gmail mailbox OAuth (Google Cloud OAuth client — Web). No Pub/Sub / Watch / KMS required.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8080/api/gmail/oauth/callback
GMAIL_FRONTEND_REDIRECT_BASE=http://localhost:5173
GMAIL_SCHEDULING_ENABLED=true
GMAIL_SYNC_INTERVAL_MS=60000
GMAIL_FOLLOWUP_INTERVAL_MS=60000
GMAIL_SYNC_LEASE_SECONDS=90
GMAIL_HISTORY_MAX_PAGES=20
GMAIL_RATE_LIMIT_INITIAL_BACKOFF_MS=1000
GMAIL_RATE_LIMIT_MAX_BACKOFF_MS=30000
GMAIL_RATE_LIMIT_MAX_ATTEMPTS=5
GMAIL_INSTANCE_ID=

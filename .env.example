SERVER_PORT=8080
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
SPRING_DATASOURCE_URL="jdbc:postgresql://HOST/neondb?sslmode=require&channel_binding=require"
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
APP_SECURITY_MODE=jwt

# Comma-separated browser origins for credentialed CORS
CORS_ALLOWED_ORIGINS=https://dev-relay.saungera.com,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Comma-separated Google OAuth client IDs (Web / Android / iOS audiences)
GOOGLE_OAUTH_CLIENT_IDS=

# Stripe card Checkout (Embedded). Same keys pattern as Payni STRIPE_* .
# When STRIPE_SECRET_KEY is empty, /subscribe activates locally (dev only).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/connections?stripe=success
STRIPE_CANCEL_URL=http://localhost:5173/connections?stripe=cancel

# Local disk root for uploaded source files
RELAY_STORAGE_ROOT=./storage

# FFmpeg for transcribing uploaded audio/video sources.
# Same value on Windows and Linux: "ffmpeg" (looks on PATH, then common install folders).
# Optional override: full path to the binary, or the folder that contains it.
#   Windows: C:\ffmpeg\bin\ffmpeg.exe   or   C:\ffmpeg\bin
#   Linux:   /usr/bin/ffmpeg            or   /usr/bin
RELAY_FFMPEG_PATH=ffmpeg
# RELAY_FFPROBE_PATH=
# RELAY_FFMPEG_TIMEOUT_SECONDS=300
# RELAY_FFMPEG_MAX_DURATION_SECONDS=1800
# RELAY_FFMPEG_SEGMENT_SECONDS=480
# Video scene sampling (unique on-screen stills merged with the transcript)
# RELAY_VIDEO_FRAME_INTERVAL_SECONDS=4
# RELAY_VIDEO_SIMILARITY_SKIP=0.85
# RELAY_VIDEO_MIN_SCENE_GAP_SECONDS=8
# RELAY_VIDEO_MAX_SCENES=10

# Dev pgvector auto-bootstrap (set to false in Neon prod after running src/main/resources/db/migration/V1__phase1_pgvector_and_sources.sql)
RELAY_PGVECTOR_AUTO_MIGRATE=true

# Fallback Google Gemini API key (AIza...) for gemini-embedding-2 (1536d) and gemini-3.8-flash when user has not connected a key in UI
GEMINI_API_KEY=

# Optional fallback Higgsfield credentials (KEY_ID:KEY_SECRET). Prefer Connections UI per user.
# Create keys at https://console.higgsfield.ai — used for Promote Shorts (Wan 3.0 text-to-video).
HIGGSFIELD_API_CREDENTIAL=

# Pinterest OAuth app (https://developers.pinterest.com/apps/)
# Redirect URI must match exactly, e.g. https://api.example.com/api/pinterest/oauth/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_OAUTH_REDIRECT_URI=http://localhost:8080/api/pinterest/oauth/callback
PINTEREST_FRONTEND_REDIRECT_BASE=http://localhost:5173
# Optional: public https image used when creating pins (covers are otherwise not public)
# RELAY_PUBLIC_PIN_IMAGE_URL=

# Reach OAuth for Promote schedule (YouTube Shorts / TikTok / Instagram Reels)
# YouTube: Google Cloud OAuth client with YouTube Data API enabled (can reuse Gmail client ids)
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8080/api/youtube/oauth/callback
# TikTok for Developers — Content Posting API + video.upload / video.publish
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:8080/api/tiktok/oauth/callback
# Meta app — Instagram content publish + Page link
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:8080/api/instagram/oauth/callback
REACH_FRONTEND_REDIRECT_BASE=http://localhost:5173

# YouTube Data API v3 key for reading YouTube channels and videos
YOUTUBE_API_KEY=

# Market research APIs for Build step 1 (Profitable pockets)
# Marketplace provider switch: auto (try Etsy Open API then Apify fallback) | etsy | apify
# Set APIFY_TOKEN and optionally RELAY_MARKETPLACE_PROVIDER=apify while your Etsy Open API app is pending;
# switch back to auto or etsy after Etsy approval.
RELAY_MARKETPLACE_PROVIDER=auto
# Etsy Open API v3 app keystring (x-api-key header, no seller OAuth required)
ETSY_API_KEY=
# Apify API token for Etsy search scraper fallback (themineworks/etsy-search-scraper)
APIFY_TOKEN=
APIFY_ETSY_ACTOR_ID=themineworks~etsy-search-scraper
RELAY_MARKET_APIFY_TIMEOUT_SECONDS=120
# Google Search + Google Trends provider switch: serpapi (default) | playwright
# Set RELAY_MARKET_GOOGLE_PROVIDER=playwright to reuse the shared Playwright browser below
# (RELAY_WEB_PLAYWRIGHT_WS_ENDPOINT=ws://127.0.0.1:3033/ or Cloud Run equivalent, or local Chromium).
# No automatic fallback between providers.
RELAY_MARKET_GOOGLE_PROVIDER=serpapi
# SerpAPI key for Google organic demand + Google Trends (engine=google & engine=google_trends)
SERPAPI_API_KEY=

# Playwright Chromium for WEB sources (keep max-concurrent=1 on GCP e2-medium)
# Option A (Docker Playwright server — no local Chromium/apt deps needed):
#   docker run --rm -d --name relay-playwright -p 3000:3000 mcr.microsoft.com/playwright:v1.49.0-jammy /bin/bash -c "npx -y playwright@1.49.0 run-server --port 3000 --host 0.0.0.0"
#   Then set RELAY_WEB_PLAYWRIGHT_WS_ENDPOINT=ws://127.0.0.1:3000/
#   (App skips local browser download when ws-endpoint is set — do not omit that var.)
# Option B (Local Chromium on host — leave RELAY_WEB_PLAYWRIGHT_WS_ENDPOINT empty):
#   mvn -q exec:java -Dexec.mainClass=com.microsoft.playwright.CLI -Dexec.args="install --with-deps chromium"
RELAY_WEB_PLAYWRIGHT_WS_ENDPOINT=
RELAY_WEB_PLAYWRIGHT_HEADLESS=true
RELAY_WEB_PLAYWRIGHT_TIMEOUT_MS=30000
RELAY_WEB_PLAYWRIGHT_MAX_CONCURRENT=1
RELAY_WEB_PLAYWRIGHT_SETTLE_MS=1500

# Partners creator scout (Playwright YouTube + Instagram; IG enriches via profile pages)
RELAY_SCOUT_MAX_RESULTS=6
RELAY_SCOUT_TIME_BUDGET_SECONDS=70
RELAY_SCOUT_CACHE_MINUTES=60

# Redis (required for live AI pricing catalog cache — local Redis or managed)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Optional: override live AI pricing catalog source & soft cache TTL (seconds, default 6h)
# RELAY_AI_PRICING_CATALOG_URL=https://models.dev/api.json
# RELAY_AI_PRICING_CACHE_TTL_SECONDS=21600

# Spring Mail SMTP fallback for Partners (placeholders only — set real values in .env)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
RELAY_MAIL_FROM=
# Reply sync for SMTP outreach (IMAP, same account)
RELAY_MAIL_REPLY_SYNC_ENABLED=true
RELAY_MAIL_IMAP_HOST=imap.gmail.com

# AES-256-GCM for Gmail OAuth tokens (Base64 of exactly 32 random bytes). No Cloud KMS.
# Generate: openssl rand -base64 32
RELAY_TOKEN_ENCRYPTION_KEY=
RELAY_TOKEN_ENCRYPTION_KEY_VERSION=1
RELAY_TOKEN_ENCRYPTION_PREVIOUS_KEY=
RELAY_TOKEN_ENCRYPTION_PREVIOUS_KEY_VERSION=0

# Gmail mailbox OAuth (Google Cloud OAuth client — Web). No Pub/Sub / Watch / KMS required.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8080/api/gmail/oauth/callback
GMAIL_FRONTEND_REDIRECT_BASE=http://localhost:5173
GMAIL_SCHEDULING_ENABLED=true
GMAIL_SYNC_INTERVAL_MS=60000
GMAIL_FOLLOWUP_INTERVAL_MS=60000
GMAIL_SYNC_LEASE_SECONDS=90
GMAIL_HISTORY_MAX_PAGES=20
GMAIL_RATE_LIMIT_INITIAL_BACKOFF_MS=1000
GMAIL_RATE_LIMIT_MAX_BACKOFF_MS=30000
GMAIL_RATE_LIMIT_MAX_ATTEMPTS=5
GMAIL_INSTANCE_ID=

# Pipeline trace logging for local demos/debugging (INFO = quiet prod default | DEBUG = [scrape]/[extract]/[ai]/[estimate]/[step] logs)
RELAY_TRACE_LEVEL=INFO

SERVER_PORT=8080
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
SPRING_DATASOURCE_URL="jdbc:postgresql://HOST/neondb?sslmode=require&channel_binding=require"
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
APP_SECURITY_MODE=jwt

# Comma-separated Google OAuth client IDs (Web / Android / iOS audiences)
GOOGLE_OAUTH_CLIENT_IDS=

# Local disk root for uploaded source files
RELAY_STORAGE_ROOT=./storage

# Dev pgvector auto-bootstrap (set to false in Neon prod after running src/main/resources/db/migration/V1__phase1_pgvector_and_sources.sql)
RELAY_PGVECTOR_AUTO_MIGRATE=true

# Fallback Google Gemini API key (AIza...) for gemini-embedding-2 (1536d) and gemini-2.5-flash when user has not connected a key in UI
GEMINI_API_KEY=

# YouTube Data API v3 key for reading YouTube channels and videos
YOUTUBE_API_KEY=
